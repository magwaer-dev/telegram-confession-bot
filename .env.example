# Copy this file to .env only if you do not already have one.
# Get the bot token from @BotFather. Keep .env private.
BOT_TOKEN=replace_with_your_bot_token
# Use @channelusername for a public channel or the numeric Telegram ID for a private channel.
CHANNEL_ID=@your_channel_username
# Optional. Set a Telegram invite link here if you want submitters to be able to join a private channel.
# CHANNEL_URL=https://t.me/+your_invite_code
# Relative paths are rooted at the project directory when using npm scripts.
DATABASE_PATH=data/confessions.sqlite
# Posting slots renew at midnight in this IANA timezone.
BOT_TIMEZONE=Europe/Chisinau
# Whole number from 1 through 5.
DAILY_POST_LIMIT=5
# Set to true to restore unlimited posting for channel admins.
ADMIN_UNLIMITED_POSTS=false
# UTF-16 units. Upper bounds are 4000 and 32 respectively.
CONFESSION_TEXT_LIMIT=4000
NICKNAME_LIMIT=32
