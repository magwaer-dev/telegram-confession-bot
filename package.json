{
  "name": "telegram-confession-bot",
  "description": "Self-hosted Telegram channel submissions with anonymous and nickname modes.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "check": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "node --test test/bot.test.js",
    "recovery": "node src/recovery.ts",
    "author": "node src/author.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ensdomains/unicode-confusables": "0.1.0",
    "dotenv": "^18.0.10",
    "grammy": "^1.48.0"
  }
}
